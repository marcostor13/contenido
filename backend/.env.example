# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/content?retryWrites=true&w=majority

# Contraseña del panel admin
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-segura

# Secreto para firmar JWT (generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Puerto (Coolify lo configura automáticamente; 3000 para local)
PORT=3000

# ─── LLM — SOLO NVIDIA NIM ────────────────────────────────────────────────────
#
# OBLIGATORIA: key nvapi-… de build.nvidia.com (login → Generate Key). Da acceso
# gratis a los mejores modelos abiertos con endpoint compatible con OpenAI
# (https://integrate.api.nvidia.com/v1). El gateway hace failover entre varios
# modelos con esta misma key para sortear la cola/cold-start del tier gratuito.

NVIDIA_API_KEY=

# Opcional: sobrescribe la cadena de modelos de failover (primero = primario).
# Default en api/lib/llm.js. IDs verificados en build.nvidia.com (2026):
#   meta/llama-3.3-70b-instruct, openai/gpt-oss-120b, meta/llama-3.1-405b-instruct,
#   qwen/qwen3.5-122b-a10b, nvidia/nemotron-3-super-120b-a12b, qwen/qwen3.5-397b-a17b
# NVIDIA_MODELS=meta/llama-3.3-70b-instruct,openai/gpt-oss-120b,meta/llama-3.1-405b-instruct

# Opcional: timeout por modelo en ms (default 75000). El tier gratis puede encolar.
# NVIDIA_TIMEOUT_MS=75000

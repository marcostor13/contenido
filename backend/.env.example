# MongoDB Atlas
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/content?retryWrites=true&w=majority

# Contraseña del panel admin
ADMIN_PASSWORD=cambia-esto-por-una-contraseña-segura

# Secreto para firmar JWT (generá uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Puerto (Coolify lo configura automáticamente; 3000 para local)
PORT=3000

# ─── LLM Providers — configurá los que tengas ────────────────────────────────
#
# RECOMENDADO — el mejor gateway gratis (prioridad más alta):
#   NVIDIA_API_KEY   → build.nvidia.com  (key nvapi-…; acceso gratis a los mejores
#                      modelos abiertos: Llama, DeepSeek, Qwen, Kimi… con endpoint
#                      compatible con OpenAI. Activa 2 pools: nvidia + nvidia_pro.)
#
# Otros gratuitos (respaldo automático por failover):
#   CEREBRAS_API_KEY → cloud.cerebras.ai  (1 M tokens/día gratis)
#   GEMINI_API_KEY   → aistudio.google.com (activa gemini + gemini_lite: 2 pools)
#   GROQ_API_KEY     → console.groq.com   (activa groq + groq_fast: 2 pools de cuota)
#
# Opcionales (pago):
#   OPENAI_API_KEY, DEEPSEEK_API_KEY

NVIDIA_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Modelos opcionales (los defaults están en api/lib/llm.js)
# NVIDIA_MODEL=meta/llama-3.3-70b-instruct
# NVIDIA_PRO_MODEL=qwen/qwen3-235b-a22b
#   Otros IDs top en build.nvidia.com: meta/llama-3.1-405b-instruct,
#   moonshotai/kimi-k2-instruct, openai/gpt-oss-120b, deepseek-ai/deepseek-r1
# CEREBRAS_MODEL=llama-3.3-70b
# GEMINI_MODEL=gemini-2.5-flash
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_MODEL=gpt-4o-mini
# DEEPSEEK_MODEL=deepseek-chat

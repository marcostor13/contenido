---
import Base from '../layouts/Base.astro'
---
<Base title="Admin · Contenido">
  <div id="login-view" class="login-wrap">
    <div class="login-box">
      <h1>Admin</h1>
      <div class="field">
        <input id="pwd-input" type="password" class="input" placeholder="Contraseña" />
      </div>
      <button id="login-btn" class="btn" style="width:100%">Entrar</button>
    </div>
  </div>

  <div id="admin-view" style="display:none">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:1.5rem">
      <a href="/" class="back" style="margin:0">← volver</a>
      <span id="article-count" class="date"></span>
    </div>

    <div class="tabs">
      <button class="tab active" data-tab="list">Artículos</button>
      <button class="tab" data-tab="new">Nuevo</button>
      <button class="tab" data-tab="gen">Generar con IA</button>
    </div>

    <!-- Lista -->
    <div id="tab-list">
      <div id="items-list" class="list"><div class="spinner"></div></div>
    </div>

    <!-- Nuevo artículo -->
    <div id="tab-new" style="display:none">
      <div class="hint">Pegá el contenido generado por Claude Code — título, markdown y metadatos.</div>
      <div class="field">
        <label class="label">Título *</label>
        <input id="f-title" type="text" class="input" placeholder="Título del artículo" />
      </div>
      <div class="field">
        <label class="label">Slug (URL) *</label>
        <input id="f-slug" type="text" class="input" placeholder="mi-articulo" />
      </div>
      <div class="field">
        <label class="label">Contenido en Markdown *</label>
        <textarea id="f-content" class="input" rows="12" placeholder="# Título&#10;&#10;Contenido en markdown..."></textarea>
      </div>
      <div class="field">
        <label class="label">Resumen</label>
        <input id="f-excerpt" type="text" class="input" placeholder="Una línea que describe el artículo" />
      </div>
      <div class="row">
        <div class="field">
          <label class="label">Categoría</label>
          <input id="f-category" type="text" class="input" placeholder="Ej: Tecnología" />
        </div>
        <div class="field">
          <label class="label">Tags (separados por coma)</label>
          <input id="f-tags" type="text" class="input" placeholder="ai, web, ideas" />
        </div>
      </div>
      <div style="display:flex;align-items:center;gap:.5rem;margin-bottom:1.25rem">
        <input id="f-published" type="checkbox" checked style="accent-color:var(--accent);width:16px;height:16px" />
        <label for="f-published" style="font-size:.9rem;color:var(--muted)">Publicar inmediatamente</label>
      </div>
      <button id="save-btn" class="btn">Guardar artículo</button>
    </div>

    <!-- Generar con IA -->
    <div id="tab-gen" style="display:none">

      <!-- Generación manual por tema -->
      <h3 style="margin:0 0 .25rem">Generar desde un tema</h3>
      <div class="hint">Elegí una sección, escribí un tema y la IA lo redacta con el tono de esa sección y lo guarda automáticamente.</div>
      <div class="row">
        <div class="field">
          <label class="label">Sección</label>
          <select id="g-section" class="input">
            <option value="historias">Historias con moraleja</option>
            <option value="historias-corto">Historias Express (corto)</option>
            <option value="productividad">Productividad & IA</option>
            <option value="productividad-corto">Productividad Express (corto)</option>
            <option value="potencial">Potencial Humano</option>
            <option value="potencial-corto">Potencial Express (corto)</option>
            <option value="motivacional">Motivación (corto)</option>
          </select>
        </div>
        <div class="field">
          <label class="label">Categoría (opcional)</label>
          <input id="g-category" type="text" class="input" placeholder="(usa la de la sección)" />
        </div>
      </div>
      <div class="field">
        <label class="label">Tema</label>
        <input id="g-topic" type="text" class="input" placeholder="Ej: cómo usar la IA para ahorrar tiempo escribiendo correos" />
      </div>
      <button id="gen-topic-btn" class="btn">Generar artículo</button>
      <div id="gen-status" class="hint" style="margin-top:.75rem"></div>

      <hr class="divider" style="margin:2rem 0" />

      <!-- Disparo manual del flujo completo (todas las secciones) -->
      <h3 style="margin:0 0 .25rem">Generar todas las secciones ahora</h3>
      <div class="hint">Ejecuta el flujo automático una vez y publica una pieza por cada sección (versiones largas y cortas de Historias, Productividad y Potencial, más Motivación). Con la rotación activada, genera solo la sección que toca.</div>
      <button id="gen-cron-btn" class="btn" style="background:#1f6feb">Generar todas las secciones ahora</button>

      <hr class="divider" style="margin:2rem 0" />

      <!-- Configuración del cron -->
      <h3 style="margin:0 0 .25rem">Automatización (cron)</h3>
      <div class="hint">El sistema corre cada minuto y genera solo cuando pasó el intervalo que definas (en minutos). Acá controlás si genera, cada cuántos minutos y con qué motor.</div>

      <div style="display:flex;align-items:center;gap:.5rem;margin:.75rem 0 .5rem">
        <input id="s-enabled" type="checkbox" style="accent-color:var(--accent);width:16px;height:16px" />
        <label for="s-enabled" style="font-size:.9rem;color:var(--muted)">Generación automática activada</label>
      </div>
      <div style="display:flex;align-items:center;gap:.5rem;margin:0 0 1rem">
        <input id="s-rotate" type="checkbox" style="accent-color:var(--accent);width:16px;height:16px" />
        <label for="s-rotate" style="font-size:.9rem;color:var(--muted)">Rotar secciones (genera una por corrida para ahorrar costos)</label>
      </div>
      <div class="row">
        <div class="field">
          <label class="label">Frecuencia (cada cuántos minutos, mínimo 5)</label>
          <input id="s-frequency" type="number" min="5" max="10080" class="input" placeholder="60" />
        </div>
        <div class="field">
          <label class="label">Motor de IA</label>
          <select id="s-provider" class="input">
            <option value="auto">Automático (reparte carga)</option>
            <option value="openai">OpenAI</option>
            <option value="deepseek">DeepSeek</option>
          </select>
        </div>
      </div>
      <div class="field">
        <label class="label">Categoría por defecto</label>
        <input id="s-category" type="text" class="input" placeholder="Tecnología" />
      </div>
      <button id="save-settings-btn" class="btn">Guardar configuración</button>
      <div id="settings-info" class="hint" style="margin-top:.75rem"></div>
    </div>
  </div>
</Base>

<script>
  let pwd = ''
  const headers = () => ({ 'x-admin-password': pwd, 'Content-Type': 'application/json' })

  // — Auth —
  document.getElementById('login-btn')!.addEventListener('click', login)
  document.getElementById('pwd-input')!.addEventListener('keydown', (e) => {
    if ((e as KeyboardEvent).key === 'Enter') login()
  })

  async function login() {
    pwd = (document.getElementById('pwd-input') as HTMLInputElement).value
    const res = await fetch('/api/content', { headers: { 'x-admin-password': pwd } })
    if (res.ok) {
      document.getElementById('login-view')!.style.display = 'none'
      document.getElementById('admin-view')!.style.display = 'block'
      loadList()
    } else {
      alert('Contraseña incorrecta')
    }
  }

  // — Tabs —
  document.querySelectorAll('.tab').forEach(btn => {
    btn.addEventListener('click', () => {
      const tab = (btn as HTMLElement).dataset.tab!
      document.querySelectorAll('.tab').forEach(b => b.classList.remove('active'))
      btn.classList.add('active')
      document.getElementById('tab-list')!.style.display = tab === 'list' ? 'block' : 'none'
      document.getElementById('tab-new')!.style.display = tab === 'new' ? 'block' : 'none'
      document.getElementById('tab-gen')!.style.display = tab === 'gen' ? 'block' : 'none'
      if (tab === 'gen') loadSettings()
    })
  })

  // — List —
  async function loadList() {
    const res = await fetch('/api/content?limit=100')
    const data = await res.json()
    const items = data.items || []
    document.getElementById('article-count')!.textContent = `${items.length} artículos`

    const el = document.getElementById('items-list')!
    if (!items.length) {
      el.innerHTML = '<p class="empty">Sin artículos aún</p>'
      return
    }
    el.innerHTML = items.map((item: any) => `
      <div class="card" style="display:flex;align-items:center;gap:.75rem;cursor:default">
        <div style="flex:1;min-width:0">
          <a href="/article/${item.slug}" style="font-weight:600;color:#fff;font-size:.9rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;display:block">
            ${item.title}
          </a>
          <span class="date">${item.category} · ${new Date(item.createdAt).toLocaleDateString('es')}</span>
        </div>
        <button class="btn danger" style="padding:.35rem .7rem;font-size:.78rem;flex-shrink:0" data-id="${item._id}">Eliminar</button>
      </div>
    `).join('')

    el.querySelectorAll('[data-id]').forEach(btn => {
      btn.addEventListener('click', async () => {
        if (!confirm('¿Eliminar este artículo?')) return
        const id = (btn as HTMLElement).dataset.id!
        await fetch(`/api/content?id=${id}`, { method: 'DELETE', headers: { 'x-admin-password': pwd } })
        loadList()
      })
    })
  }

  // — Save —
  const titleEl = document.getElementById('f-title') as HTMLInputElement
  const slugEl = document.getElementById('f-slug') as HTMLInputElement

  titleEl.addEventListener('input', () => {
    if (!slugEl.dataset.manual) {
      slugEl.value = titleEl.value
        .toLowerCase()
        .normalize('NFD').replace(/[̀-ͯ]/g, '')
        .replace(/[^a-z0-9\s-]/g, '')
        .trim().replace(/\s+/g, '-')
    }
  })
  slugEl.addEventListener('input', () => { slugEl.dataset.manual = '1' })

  document.getElementById('save-btn')!.addEventListener('click', async () => {
    const btn = document.getElementById('save-btn') as HTMLButtonElement
    const title = titleEl.value.trim()
    const slug = slugEl.value.trim()
    const content = (document.getElementById('f-content') as HTMLTextAreaElement).value.trim()
    if (!title || !slug || !content) { alert('Título, slug y contenido son requeridos'); return }

    btn.disabled = true
    btn.textContent = 'Guardando...'

    const body = {
      title, slug, content,
      excerpt: (document.getElementById('f-excerpt') as HTMLInputElement).value.trim(),
      category: (document.getElementById('f-category') as HTMLInputElement).value.trim() || 'General',
      tags: (document.getElementById('f-tags') as HTMLInputElement).value.split(',').map(t => t.trim()).filter(Boolean),
      published: (document.getElementById('f-published') as HTMLInputElement).checked,
    }

    const res = await fetch('/api/content', { method: 'POST', headers: headers(), body: JSON.stringify(body) })
    if (res.ok) {
      btn.textContent = '¡Guardado!'
      btn.classList.add('success')
      ;['f-title','f-slug','f-content','f-excerpt','f-category','f-tags'].forEach(id => {
        (document.getElementById(id) as HTMLInputElement).value = ''
      })
      slugEl.removeAttribute('data-manual')
      loadList()
      setTimeout(() => {
        btn.textContent = 'Guardar artículo'
        btn.classList.remove('success')
        btn.disabled = false
      }, 2000)
    } else {
      alert('Error al guardar')
      btn.disabled = false
      btn.textContent = 'Guardar artículo'
    }
  })

  // ——— Generar con IA ———
  const genStatus = document.getElementById('gen-status')!

  // Generar a partir de un tema escrito.
  document.getElementById('gen-topic-btn')!.addEventListener('click', async () => {
    const btn = document.getElementById('gen-topic-btn') as HTMLButtonElement
    const topic = (document.getElementById('g-topic') as HTMLInputElement).value.trim()
    const category = (document.getElementById('g-category') as HTMLInputElement).value.trim()
    const section = (document.getElementById('g-section') as HTMLSelectElement).value
    if (!topic) { alert('Escribí un tema'); return }
    btn.disabled = true; btn.textContent = 'Generando...'
    genStatus.textContent = 'Analizando tema, conectando con IA y redactando... (puede tardar unos segundos)'
    try {
      const res = await fetch('/api/generate', {
        method: 'POST', headers: headers(),
        body: JSON.stringify({ topic, section, category: category || undefined }),
      })
      const data = await res.json()
      if (res.ok && data.article) {
        genStatus.innerHTML = `✅ Generado con <b>${data.article.generatedBy}</b>: <a href="/article/${data.article.slug}" style="color:var(--accent)">${data.article.title}</a>`
        ;(document.getElementById('g-topic') as HTMLInputElement).value = ''
        loadList()
      } else {
        genStatus.textContent = '❌ ' + (data.error || 'Error al generar')
      }
    } catch (e: any) {
      genStatus.textContent = '❌ ' + e.message
    }
    btn.disabled = false; btn.textContent = 'Generar artículo'
  })

  // Disparar el flujo de noticias manualmente.
  document.getElementById('gen-cron-btn')!.addEventListener('click', async () => {
    const btn = document.getElementById('gen-cron-btn') as HTMLButtonElement
    btn.disabled = true; btn.textContent = 'Generando...'
    genStatus.textContent = 'Generando una pieza por cada sección (puede tardar un poco)...'
    try {
      const res = await fetch('/api/generate', {
        method: 'POST', headers: headers(), body: JSON.stringify({ runCron: true }),
      })
      const data = await res.json()
      if (res.ok && Array.isArray(data.results)) {
        const lines = data.results.map((r: any) => {
          if (r.ok && r.article) return `✅ <b>${r.section}</b>: <a href="/article/${r.article.slug}" style="color:var(--accent)">${r.article.title}</a>`
          if (r.skipped) return `ℹ️ <b>${r.section}</b>: omitido (${r.reason})`
          if (r.error) return `❌ <b>${r.section}</b>: ${r.message}`
          return ''
        }).filter(Boolean)
        genStatus.innerHTML = lines.join('<br>') || 'Sin resultados.'
        loadList()
      } else if (res.ok && data.skipped) {
        genStatus.textContent = 'ℹ️ Omitido: ' + data.reason
      } else {
        genStatus.textContent = '❌ ' + (data.error || 'Error')
      }
    } catch (e: any) {
      genStatus.textContent = '❌ ' + e.message
    }
    btn.disabled = false; btn.textContent = 'Generar todas las secciones ahora'
  })

  // ——— Configuración del cron ———
  const settingsInfo = document.getElementById('settings-info')!
  let settingsLoaded = false

  async function loadSettings() {
    if (settingsLoaded) return
    try {
      const res = await fetch('/api/settings', { headers: headers() })
      if (!res.ok) { settingsInfo.textContent = 'No se pudo cargar la configuración'; return }
      const { settings, providers } = await res.json()
      ;(document.getElementById('s-enabled') as HTMLInputElement).checked = !!settings.enabled
      ;(document.getElementById('s-rotate') as HTMLInputElement).checked = !!settings.rotateSections
      ;(document.getElementById('s-frequency') as HTMLInputElement).value = String(settings.frequencyMinutes || 60)
      ;(document.getElementById('s-provider') as HTMLSelectElement).value = settings.provider || 'auto'
      ;(document.getElementById('s-category') as HTMLInputElement).value = settings.category || 'Tecnología'
      renderSettingsInfo(settings, providers)
      settingsLoaded = true
    } catch (e: any) {
      settingsInfo.textContent = 'Error: ' + e.message
    }
  }

  function renderSettingsInfo(settings: any, providers: string[]) {
    const last = settings.lastRunAt ? new Date(settings.lastRunAt).toLocaleString('es') : 'nunca'
    const prov = providers?.length ? providers.join(', ') : 'ninguno (configurá OPENAI_API_KEY o DEEPSEEK_API_KEY)'
    const pb = settings.playbook
    const freq = settings.frequencyMinutes || 60
    const freqTxt = freq % 60 === 0 ? `${freq / 60} h` : `${freq} min`
    const modo = settings.rotateSections ? 'una sección por corrida (rotando)' : 'todas las secciones por corrida'
    settingsInfo.innerHTML =
      `Motores conectados: <b>${prov}</b><br>Frecuencia: cada <b>${freqTxt}</b> · ${modo}<br>Última generación automática: ${last}` +
      (pb ? `<br>🧠 Aprendizaje: ${pb.runs || 0} ciclos · actualizado ${pb.updatedAt ? new Date(pb.updatedAt).toLocaleString('es') : '-'}` : '') +
      (settings.lastError ? `<br><span style="color:#f85149">Último error: ${settings.lastError}</span>` : '')
  }

  document.getElementById('save-settings-btn')!.addEventListener('click', async () => {
    const btn = document.getElementById('save-settings-btn') as HTMLButtonElement
    btn.disabled = true; btn.textContent = 'Guardando...'
    const body = {
      enabled: (document.getElementById('s-enabled') as HTMLInputElement).checked,
      rotateSections: (document.getElementById('s-rotate') as HTMLInputElement).checked,
      frequencyMinutes: Number((document.getElementById('s-frequency') as HTMLInputElement).value) || 60,
      provider: (document.getElementById('s-provider') as HTMLSelectElement).value,
      category: (document.getElementById('s-category') as HTMLInputElement).value.trim() || 'Tecnología',
    }
    try {
      const res = await fetch('/api/settings', { method: 'POST', headers: headers(), body: JSON.stringify(body) })
      const data = await res.json()
      if (res.ok) {
        btn.textContent = '¡Guardado!'; btn.classList.add('success')
        setTimeout(() => { btn.textContent = 'Guardar configuración'; btn.classList.remove('success'); btn.disabled = false }, 1500)
      } else {
        alert(data.error || 'Error'); btn.disabled = false; btn.textContent = 'Guardar configuración'
      }
    } catch (e: any) {
      alert(e.message); btn.disabled = false; btn.textContent = 'Guardar configuración'
    }
  })
</script>
